PORT=3000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
# Número de proxies confiables; usa 1 si la API está detrás de un proxy en producción.
TRUST_PROXY=
# Obligatorio en producción: mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza-por-una-clave-aleatoria-larga
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flex_english_db
# Usa un usuario con permisos mínimos (ver database/app-user.sql), no root.
DB_USER=pro_english_app
DB_PASSWORD=coloca-tu-contraseña-aqui
DEMO_AUTO_SETUP=false
DEMO_CONTRACT_WEEKLY_HOURS=6
# Required only when recepcion has no account yet; choose private values before running npm run bootstrap:reception.
BOOTSTRAP_RECEPTION_USERNAME=
BOOTSTRAP_RECEPTION_NAME=
BOOTSTRAP_RECEPTION_PASSWORD=
# Límites de peticiones por IP (opcional). General: por cada 5 min. Escritura: por cada 15 min.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WRITE_MAX=300